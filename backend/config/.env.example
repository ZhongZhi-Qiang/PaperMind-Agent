# Network: bypass system proxy for API calls
NO_PROXY=*

# PostgreSQL for memory_module_v2
POSTGRES_DSN=postgresql://postgres:postgres@localhost:5432/postgres

# LLM defaults
# Supported providers: zhipu, bailian, deepseek, openai
LLM_PROVIDER=openai
LLM_MODEL=mimo-v2.5-pro
LLM_API_KEY=your_api_key_here
LLM_BASE_URL=https://your-api-endpoint/v1

# Guardian (prompt-injection pre-filter)
# GUARDIAN_ENABLED=true -> enable pre-check; false -> bypass guardian
GUARDIAN_ENABLED=true
# Supported providers: zhipu, bailian, deepseek, openai
GUARDIAN_PROVIDER=openai
GUARDIAN_MODEL=mimo-v2.5-pro
GUARDIAN_API_KEY=your_api_key_here
GUARDIAN_BASE_URL=https://your-api-endpoint/v1
# Timeout for guardian request in milliseconds
GUARDIAN_TIMEOUT_MS=5000
# closed -> block when guardian call fails; open -> allow when guardian call fails
GUARDIAN_FAIL_MODE=open
GUARDIAN_BLOCK_MESSAGE=检测到潜在不合规内容，本次请求已被拦截。

# Zhipu / BigModel
ZHIPU_API_KEY=your_key
ZHIPUAI_API_KEY=your_key
ZHIPU_BASE_URL=https://open.bigmodel.cn/api/paas/v4/
ZHIPU_MODEL=glm-5

# Bailian / DashScope
BAILIAN_API_KEY=your_key
DASHSCOPE_API_KEY=your_key
BAILIAN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
BAILIAN_MODEL=qwen3.5-plus

# DeepSeek
DEEPSEEK_API_KEY=your_key
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# OpenAI-compatible embeddings defaults
# Supported providers: bailian, openai, local
EMBEDDING_PROVIDER=openai
EMBEDDING_MODEL=text-embedding-v4
EMBEDDING_API_KEY=your_api_key_here
EMBEDDING_BASE_URL=https://your-api-endpoint/v1

# OpenAI embeddings
OPENAI_API_KEY=your_key
OPENAI_BASE_URL=https://api.openai.com/v1

# Tavily web search
TAVILY_API_KEY=your_key
TAVILY_PROJECT=

# Langfuse (tracing; optional)
LANGFUSE_SECRET_KEY=""
LANGFUSE_PUBLIC_KEY=""
LANGFUSE_BASE_URL=""

# Postgres checkpointer for short-term memory (persists harness_review, conversation state)
CHECKPOINTER=postgres
# Uses POSTGRES_DSN from line 5 above

# Optional: Summarization (short-term memory compression)
SUMMARIZATION_ENABLED=true
SUMMARIZATION_TRIGGER_MESSAGES=50
SUMMARIZATION_KEEP_MESSAGES=20

# ── Long-term memory backend (unified switch) ──
# "off" = no long-term memory (default)
# "v3"  = four-layer memory pyramid (L0→L1→L2→L3, auto-capture + auto-recall)
MEMORY_BACKEND=v3

# ── memory_module_v3: four-layer memory pyramid (only when MEMORY_BACKEND=v3) ──
# Injection strategy: "always" (default) | "tool" | "off"
# MEMORY_V3_INJECT=always
# Recall strategy: "hybrid" (default, pgvector + tsvector + RRF) | "keyword" | "embedding"
# MEMORY_V3_RECALL_STRATEGY=hybrid
# L1 extraction trigger: every N conversations in steady state
# MEMORY_V3_PIPELINE_EVERY_N=5
# L1 idle timeout: trigger L1 if no extraction for N seconds
# MEMORY_V3_L1_IDLE_TIMEOUT=300
# L2 delay after L1: wait N seconds after L1 before running L2
# MEMORY_V3_L2_DELAY_AFTER_L1=120
# L2 max interval: force L2 every N seconds
# MEMORY_V3_L2_MAX_INTERVAL=3600
# L3 persona trigger: regenerate after N total facts
# MEMORY_V3_L3_TRIGGER_EVERY_N=50
# Retrieval limits
# MEMORY_V3_DENSE_TOP_K=20
# MEMORY_V3_KEYWORD_TOP_K=20
# MEMORY_V3_FINAL_TOP_K=10
# MEMORY_V3_INJECT_TOP_K=5
# MEMORY_V3_MAX_CHARS_PER_MEMORY=500
# MEMORY_V3_MAX_TOTAL_RECALL_CHARS=3000

# ── Daily arXiv Digest ──
ARXIV_DIGEST_ENABLED=true
ARXIV_DIGEST_HOUR=8
WECHAT_WEBHOOK_KEY=your_webhook_key_here

# ===== Harness =====
HARNESS_ENABLED=true
HARNESS_SECURITY_ENABLED=true
HARNESS_REVIEW_ENABLED=true
HARNESS_RULES_PATH=config/harness_rules.yaml
